# Clé API OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Variables d'environnement Vercel (si nécessaire pour la CI/CD, mais VERCEL_TOKEN sera dans les secrets GitHub)
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id

# Configuration de la base de données (exemple pour Supabase)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Configuration de l'authentification (exemple pour Clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# CLERK_SECRET_KEY=your_clerk_secret_key
